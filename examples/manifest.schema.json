{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flashylabs/flashy-examples/blob/main/examples/manifest.schema.json",
  "title": "flashy-examples manifest",
  "description": "Machine-readable index of the examples in this repository.",
  "type": "object",
  "required": ["manifest", "generated", "examples"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "manifest": { "const": "flashy-examples/1" },
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string" },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dir", "title", "standard", "standalone", "runs", "packages", "teaches"],
        "additionalProperties": false,
        "properties": {
          "dir": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "standard": { "type": "string", "minLength": 1 },
          "standalone": {
            "type": "boolean",
            "description": "true iff runs is 'standalone'. Kept alongside runs for readers of the first revision."
          },
          "runs": {
            "type": "string",
            "enum": ["standalone", "needs-packages"],
            "description": "standalone: runs and tests with nothing installed. needs-packages: imports at least one npm package, listed in packages."
          },
          "packages": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^(@[a-z0-9-]+/)?[a-z0-9._-]+$" },
            "description": "Exactly the bare-specifier npm packages the example's index.mjs and index.test.mjs import. Empty iff runs is 'standalone'."
          },
          "teaches": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
